; Insert this group into the existing transaction_body map.
; Key 30 is a placeholder, not an assigned transaction-body key.
enactment_fields = (
  ? 30 : required_enactments
)

; One entry per action ID, even when supplied parents differ.
; CDDL alone does not enforce this uniqueness requirement.
required_enactments = nonempty_set<required_enactment>

; nil asserts that the enacted action has no parent; it does not skip the check.
; A parent need not have its own entry in required_enactments.
required_enactment = [
  action : gov_action_id,
  parent : gov_action_id / nil
]

; Existing ledger types, repeated here to make the fragment self-contained.
; Set elements must be distinct; CDDL alone does not enforce uniqueness.
nonempty_set<a0> = #6.258([+ a0]) / [+ a0]

gov_action_id = [
  transaction_id : transaction_id,
  gov_action_index : uint .size 2
]

transaction_id = bytes .size 32
