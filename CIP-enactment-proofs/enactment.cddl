; Insert this group into the existing transaction_body map.
; Key 30 is a placeholder.
enactment_fields = (
  ? 30 : required_enactments
)

; Reject duplicate action IDs and repeated RootOf claims for the same purpose.
required_enactments = { + gov_action_id => enactment_requirement }

enactment_requirement =
    0  ; Enacted
  / 1  ; NonRoot
  / 2  ; RootOf PParamUpdatePurpose
  / 3  ; RootOf HardForkPurpose
  / 4  ; RootOf CommitteePurpose
  / 5  ; RootOf ConstitutionPurpose

; Existing ledger types, repeated here to make the fragment self-contained.
gov_action_id = [
  transaction_id : transaction_id,
  gov_action_index : uint .size 2
]

transaction_id = bytes .size 32
