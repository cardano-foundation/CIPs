diff --git a/abstract-sim-hs/config/sweeps/announcement-semantics-smoke.json b/abstract-sim-hs/config/sweeps/announcement-semantics-smoke.json
new file mode 100644
index 00000000..dd7915b5
--- /dev/null
+++ b/abstract-sim-hs/config/sweeps/announcement-semantics-smoke.json
@@ -0,0 +1,27 @@
+{
+  "description": "Exploratory paired four-arm ablation of the simulator's announcement semantics against the CIP's specified semantics. Holds the S=.75/U=.50, D16, half-RB threshold, K10 mechanism fixed while varying two independent knobs: (1) block-window takes the standard controller's 20-entry window over processed-block summaries only, filtering out the zero-width EbAnnounced entries that the historical signal lets occupy window positions; (2) cert-reset restarts the EB age-escape count when a certified EB is applied, matching the specified 'Ranking Blocks since an EB certificate last entered the chain', instead of at every announcement (including announcements whose EB is later dropped without certifying). The fourth arm applies both. Ten paired seeds across the five headline loads plus the 0.1 tx/slot trickle (where the age escape binds) are intended as a directional smoke test, not confirmatory evidence.",
+  "seedStart": 440,
+  "seeds": 10,
+  "slots": 2000,
+  "summaryOnly": true,
+  "randomness": "independent-streams",
+  "out": "sweep-results/announcement-semantics-smoke/severe-congestion",
+  "variants": [
+    {
+      "name": "historical",
+      "config": "config/variants/standard-target-screen/s75-u50.json"
+    },
+    {
+      "name": "block-window",
+      "config": "config/variants/announcement-semantics/block-window.json"
+    },
+    {
+      "name": "cert-reset",
+      "config": "config/variants/announcement-semantics/cert-reset.json"
+    },
+    {
+      "name": "block-window-cert-reset",
+      "config": "config/variants/announcement-semantics/block-window-cert-reset.json"
+    }
+  ]
+}
diff --git a/abstract-sim-hs/config/sweeps/recommended-headlines.json b/abstract-sim-hs/config/sweeps/recommended-headlines.json
new file mode 100644
index 00000000..7c0cb466
--- /dev/null
+++ b/abstract-sim-hs/config/sweeps/recommended-headlines.json
@@ -0,0 +1,18 @@
+{
+  "description": "Refresh of the CIP headline comparisons under the adopted recommended construction: flat fee versus the mechanism with the 0.75 standard target, the 10-block processed-block standard window, and the age-escape reset at certification. The window length and the reset rule were selected by the standard-window screen (seeds 0-99), bounded by the announcement-semantics smoke (seeds 440-449), and confirmed on disjoint seeds (500-599). The runner applies each of the five headline load profiles to this manifest, using ten paired seeds and 2,000 slots without retaining event traces.",
+  "seeds": 10,
+  "slots": 2000,
+  "summaryOnly": true,
+  "randomness": "independent-streams",
+  "out": "sweep-results/recommended-headlines",
+  "variants": [
+    {
+      "name": "flat-fee",
+      "config": "config/variants/flat-fee.json"
+    },
+    {
+      "name": "recommended",
+      "config": "config/variants/standard-window-confirm/block-window-10-cert-reset.json"
+    }
+  ]
+}
diff --git a/abstract-sim-hs/config/sweeps/standard-window-confirm.json b/abstract-sim-hs/config/sweeps/standard-window-confirm.json
new file mode 100644
index 00000000..5366fdcc
--- /dev/null
+++ b/abstract-sim-hs/config/sweeps/standard-window-confirm.json
@@ -0,0 +1,23 @@
+{
+  "description": "Confirmation of the standard-window screen's selection on disjoint seeds. The candidate is the exact configuration the CIP will specify: the standard controller's utilisation window taken over the 10 most recent processed-block summaries (announcements excluded), and the EB age-escape count reset at certified-EB application rather than at announcement. It is compared against the historical announcement-diluted 20-entry window with announcement-time reset, and against flat fee. Seeds 500-599 are disjoint from the screen (0-99) and from every earlier selection experiment. Pre-declared pass criteria, all of which must hold (conjunctive gating, so no multiplicity adjustment), evaluated mechanically by scripts/compare_standard_window_confirm.py: C1 launch-day overall retained value beats historical (95% CI above zero and candidate higher in at least 90% of seed pairs); C2 severe-congestion and EB-capacity-stress overall retained-value ratio within 0.05 percentage points of historical (95% CI lower bound above -0.05); C3 overall retained value beats flat fee at severe congestion, EB-capacity stress, and launch day (95% CI above zero); C4 trickle standard-lane retained-value ratio within 1 percentage point of historical (95% CI lower bound above -1.0). Mid-load bit-identity to historical is expected and reported but not gated.",
+  "seedStart": 500,
+  "seeds": 100,
+  "slots": 2000,
+  "summaryOnly": true,
+  "randomness": "independent-streams",
+  "out": "sweep-results/standard-window-confirm/severe-congestion",
+  "variants": [
+    {
+      "name": "historical",
+      "config": "config/variants/standard-target-screen/s75-u50.json"
+    },
+    {
+      "name": "flat-fee",
+      "config": "config/variants/flat-fee.json"
+    },
+    {
+      "name": "block-window-10-cert-reset",
+      "config": "config/variants/standard-window-confirm/block-window-10-cert-reset.json"
+    }
+  ]
+}
diff --git a/abstract-sim-hs/config/sweeps/standard-window-screen.json b/abstract-sim-hs/config/sweeps/standard-window-screen.json
new file mode 100644
index 00000000..f5d7ef57
--- /dev/null
+++ b/abstract-sim-hs/config/sweeps/standard-window-screen.json
@@ -0,0 +1,35 @@
+{
+  "description": "Exploratory screen of the standard controller's window length under the enforceable processed-block window semantics. The announcement-semantics smoke showed that the historical signal's zero-width EbAnnounced entries shorten the effective window at contended loads (to roughly 10-13 processed blocks), and that a clean 20-processed-block window loses launch-day retained value against it. Announcement entries are not adoptable in the ledger rule: an announcement is a costless, unpunishable producer claim, so counting it would hand producers a free lever on the standard quote. This screen therefore asks whether a shorter processed-block window recovers the historical performance. Arms: the historical announcement-diluted 20-entry window (reference), flat fee (baseline), and processed-block windows of 10, 13, 15, and 20. Everything else is fixed at S=.75/U=.50, D16, half-RB threshold, K10, announcement-time age reset. One hundred paired seeds across the five headline loads plus the 0.1 tx/slot trickle. This is a screen: any selected length needs confirmation on disjoint seeds before adoption.",
+  "seedStart": 0,
+  "seeds": 100,
+  "slots": 2000,
+  "summaryOnly": true,
+  "randomness": "independent-streams",
+  "out": "sweep-results/standard-window-screen/severe-congestion",
+  "variants": [
+    {
+      "name": "historical",
+      "config": "config/variants/standard-target-screen/s75-u50.json"
+    },
+    {
+      "name": "flat-fee",
+      "config": "config/variants/flat-fee.json"
+    },
+    {
+      "name": "block-window-10",
+      "config": "config/variants/standard-window-screen/block-window-10.json"
+    },
+    {
+      "name": "block-window-13",
+      "config": "config/variants/standard-window-screen/block-window-13.json"
+    },
+    {
+      "name": "block-window-15",
+      "config": "config/variants/standard-window-screen/block-window-15.json"
+    },
+    {
+      "name": "block-window-20",
+      "config": "config/variants/standard-window-screen/block-window-20.json"
+    }
+  ]
+}
