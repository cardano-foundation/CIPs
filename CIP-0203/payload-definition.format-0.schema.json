{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cardano-foundation/CIPs/blob/master/CIP-0203/payload-definition.format-0.schema.json",
  "title": "Block Producer Payload Definition, format 0",
  "description": "Machine-readable definition for decoding the 22-bit implementation-defined payload of the header minor version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition_format"],
  "properties": {
    "definition_format": {
      "const": 0,
      "description": "Version of the definition language this document is written in."
    },
    "fields": {
      "$ref": "#/$defs/fields",
      "description": "Fields that apply to every payload."
    },
    "layout_version": {
      "$ref": "#/$defs/layoutVersion",
      "description": "Implementation-defined layout version that selects one of several payload layouts."
    }
  },
  "oneOf": [
    { "required": ["fields"], "not": { "required": ["layout_version"] } },
    { "required": ["layout_version"], "not": { "required": ["fields"] } }
  ],
  "$defs": {
    "bitRange": {
      "type": "array",
      "description": "Inclusive range [low, high] of payload bits. Bit 0 is the least significant and bit 21 the most significant.",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 21 },
        { "type": "integer", "minimum": 0, "maximum": 21 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "valueKeys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" }
    },
    "fieldName": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["name", "id", "scheme", "definition_format"] },
      "description": "Implementation-defined name exposed to consumers."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "field": {
      "oneOf": [
        { "$ref": "#/$defs/integerField" },
        { "$ref": "#/$defs/booleanField" },
        { "$ref": "#/$defs/enumField" }
      ]
    },
    "integerField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "bits"],
      "properties": {
        "name": { "$ref": "#/$defs/fieldName" },
        "type": { "const": "integer" },
        "bits": { "$ref": "#/$defs/bitRange" }
      }
    },
    "booleanField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "bits"],
      "properties": {
        "name": { "$ref": "#/$defs/fieldName" },
        "type": { "const": "boolean" },
        "bits": {
          "$ref": "#/$defs/bitRange",
          "description": "Both values MUST be equal."
        }
      }
    },
    "enumField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "bits", "values"],
      "properties": {
        "name": { "$ref": "#/$defs/fieldName" },
        "type": { "const": "enum" },
        "bits": { "$ref": "#/$defs/bitRange" },
        "values": {
          "$ref": "#/$defs/valueKeys",
          "additionalProperties": { "type": "string" },
          "description": "Maps unsigned integer field values, written as decimal keys, to labels."
        }
      }
    },
    "layoutVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bits", "layouts"],
      "properties": {
        "bits": { "$ref": "#/$defs/bitRange" },
        "layouts": {
          "$ref": "#/$defs/valueKeys",
          "additionalProperties": { "$ref": "#/$defs/layout" },
          "description": "Maps layout version values, written as decimal keys, to payload layouts."
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "$ref": "#/$defs/fields" }
      }
    }
  }
}
