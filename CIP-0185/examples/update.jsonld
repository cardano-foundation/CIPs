    "body": {
        "governanceActionId": "4547c1a52ef27d3cb784c3f3a0bf0aa15600ee85969369ba0945bcd84e0fd1f3#0",
        "updateType": "Clarification",
        "sequenceNumber": 1,
        "updateContext": "Following the community town hall on April 15th, we are clarifying the budget breakdown for milestone 2. The figure stated in the proposal covers audit costs only; engineering costs for milestone 2 are covered by the milestone 1 disbursement, as several DReps asked.",
        "bindingStatements": [
            {
                "field": "milestones[2].budget",
                "originalText": "Milestone 2: 150,000 ada",
                "revisedText": "Milestone 2: 150,000 ada, covering third-party audit costs only; engineering costs are covered under milestone 1.",
                "rationale": "Two defensible readings existed; this fixes the intended one without changing any amount."
            }
        ],
        "references": [
            {
                "@type": "Other",
                "label": "Town Hall Recording",
                "uri": "https://example.com/town-hall-2026-04-15"
            }
        ]
    },
