  },
  "blueprint": {
    "uri": "https://raw.githubusercontent.com/example-org/escrow/v1.2.0/plutus.json",
    "hash": {
      "alg": "sha256",
      "digest": "3f8a1c2b9d4e5f60718293a4b5c6d7e8f9012a3b4c5d6e7f8091a2b3c4d5e6f7"
    }
  },
  "languages": {
    "ual": {
      "name": "Universal Annotation Language",
