  "preamble": {
    "title": "Escrow contract — formal verification assurance",
    "description": "Machine-checked safety properties of the escrow validator, verified with Blaster.",
    "version": "1.0.0",
    "authors": [
      "Input Output — Blaster team <blaster@iohk.io>"
